    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:or ( [ sh:class esadm:Autonomia ;
                sh:path :belongsTo ] [ sh:class esadm:Barrio ;
                sh:path :belongsTo ] [ sh:class esadm:Ciudad ;
                sh:path :belongsTo ] [ sh:class esadm:Distrito ;
                sh:path :belongsTo ] [ sh:class esadm:Municipio ;
                sh:path :belongsTo ] [ sh:class esadm:Provincia ;
                sh:path :belongsTo ] ) .

